{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(mvnw *)",
      "Bash(java *)",
      "Bash(javac *)",
      "Bash(git *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/secrets.json)",
      "Read(./**/secrets/**)",
      "Read(./**/APIKEY/**)"
    ]
  },
  "env": {},
  "language": "chinese",
  "includeGitInstructions": true
}