{
  "bindHost": "127.0.0.1",
  "port": 8082,
  "dataDir": "/var/lib/gitcode-feature-evolver/data",
  "worktreeRoot": "/var/lib/gitcode-feature-evolver/worktrees",
  "localRepository": "/opt/gitcode-feature-evolver/repo",
  "featureSkill": "/opt/gitcode-feature-evolver/repo/resources/skills/gitcode-feature-devflow",
  "codingStandardSkill": "/opt/gitcode-feature-evolver/repo/resources/skills/coding-standard",
  "targetRepository": "openJiuwen/agent-core-java",
  "publishRepository": "antonjli/agent-core-java-bot",
  "baseBranch": "730",
  "componentRoot": ".",
  "assignees": ["<gitcode-reviewer-login>"],
  "approverLogins": ["<gitcode-approver-login>"],
  "triggerMode": "both",
  "triggerLabel": "feature",
  "issueScanWindowHours": 24,
  "pollIntervalMinutes": 15,
  "maxIssueScanPages": 10,
  "defaultWorkflowMode": "attended",
  "gitUserName": "gitcode-feature-evolver",
  "gitUserEmail": "gitcode-feature-evolver@localhost",
  "containerRuntime": "podman",
  "containerImage": "<replace-with-image@sha256:digest>",
  "containerMavenCache": "/var/lib/gitcode-feature-evolver/m2",
  "containerUser": "1000:1000",
  "containerTimeoutMinutes": 30,
  "containerMemoryMb": 2048,
  "containerCpus": "2.0",
  "containerPidsLimit": 256
}
