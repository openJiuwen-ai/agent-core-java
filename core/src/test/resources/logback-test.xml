<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy TaskScheduler loop logs -->
    <logger name="com.openjiuwen.core.controller.modules" level="WARN"/>

    <!-- General test logging -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
